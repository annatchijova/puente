rules_version = '2';

// Level 1 authority model (see TECHNICAL.md):
// - a professional sees a patient's record only while listed as currently
//   treating that patient, checked at read time, not granted permanently
//   on first contact.
// - a patient can read their own record; they cannot create, edit, or
//   request studies.
// - closed by default: anything not explicitly allowed below is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTreatingProfessional(patientId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/patients/$(patientId)/treatingProfessionals/$(request.auth.uid));
    }

    function isPatientSelf(patientId) {
      return isSignedIn() && request.auth.uid == patientId;
    }

    match /patients/{patientId} {
      allow read: if isTreatingProfessional(patientId) || isPatientSelf(patientId);
      allow write: if false; // patient demographic record is seeded, not edited via the client

      match /treatingProfessionals/{profId} {
        // membership list itself is only readable by members of it (so a
        // professional can see who else treats this patient) or the patient.
        allow read: if isTreatingProfessional(patientId) || isPatientSelf(patientId);
        allow write: if false; // granted by an authorized backend process only
      }

      match /documents/{docId} {
        allow read: if isTreatingProfessional(patientId) || isPatientSelf(patientId);
        // a document is sealed (hash + authorship) at write time by a
        // treating professional; it is never edited after creation.
        allow create: if isTreatingProfessional(patientId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasAll(['authorId', 'createdAt', 'sha256', 'kind', 'content']);
        allow update, delete: if false;
      }

      match /translations/{docId} {
        allow read: if isTreatingProfessional(patientId) || isPatientSelf(patientId);
        // a translation is saved once by the professional who reviewed it,
        // beside the sealed source document it explains, never inside it.
        allow create: if isTreatingProfessional(patientId)
          && exists(/databases/$(database)/documents/patients/$(patientId)/documents/$(docId))
          && request.resource.data.documentId == docId
          && request.resource.data.generatedBy == request.auth.uid
          && request.resource.data.generatedAt == request.time
          && request.resource.data.modality in ['on-device', 'cloud']
          && request.resource.data.keys().hasOnly(
               ['documentId', 'sentences', 'generatedAt', 'generatedBy', 'modality']);
        allow update, delete: if false; // fixed once saved; regenerating creates a new review, not a silent edit
      }

      match /orders/{orderId} {
        function validEvent(event) {
          return event.keys().hasOnly(['at', 'by'])
            && event.at == request.time && event.by == request.auth.uid;
        }

        function isNextState(before, after) {
          return (before == 'requested' && after == 'scheduled')
            || (before == 'scheduled' && after == 'performed')
            || (before == 'performed' && after == 'result_received')
            || (before == 'result_received' && after == 'result_reviewed');
        }

        function validRequest(data) {
          return data.keys().hasOnly(['description', 'requestedBy', 'requestedAt', 'state', 'transitions'])
            && data.description is string
            && data.description.size() <= 200
            && data.description.matches('.*[^[:space:]].*')
            && data.requestedBy == request.auth.uid
            && data.requestedAt == request.time
            && data.state == 'requested'
            && data.transitions.keys().hasOnly(['requested'])
            && validEvent(data.transitions.requested);
        }

        function validTransition(before, after) {
          let previous = before.get('transitions', {});
          return isNextState(before.state, after.state)
            && after.diff(before).affectedKeys().hasOnly(['state', 'transitions'])
            && !(after.state in previous)
            && after.transitions.diff(previous).affectedKeys().hasOnly([after.state])
            && validEvent(after.transitions[after.state]);
        }

        allow read: if isTreatingProfessional(patientId) || isPatientSelf(patientId);
        allow create: if isTreatingProfessional(patientId) && validRequest(request.resource.data);
        allow update: if isTreatingProfessional(patientId)
          && validTransition(resource.data, request.resource.data);
        allow delete: if false;
      }

      match /reviews/{reviewId} {
        allow read: if isTreatingProfessional(patientId) || isPatientSelf(patientId);
        allow create: if isTreatingProfessional(patientId)
          && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if false; // a review is preserved, never overwritten
      }

      // Level 4 peer review (see docs/peer-review-design.md). Kept separate
      // from /reviews above: that generic path permits patient reads and
      // does not enforce assignment, both wrong for this workflow — a
      // second-opinion request and its response stay within the treating
      // team only.
      match /reviewRequests/{requestId} {
        function sealedDigestMatches(data) {
          return data.resultDigest ==
            get(/databases/$(database)/documents/patients/$(patientId)/documents/$(data.documentId)).data.sha256;
        }

        allow read: if isTreatingProfessional(patientId);
        allow create: if isTreatingProfessional(patientId)
          && request.resource.data.requesterId == request.auth.uid
          && request.resource.data.assigneeId != request.auth.uid
          && exists(/databases/$(database)/documents/patients/$(patientId)/treatingProfessionals/$(request.resource.data.assigneeId))
          && request.resource.data.createdAt == request.time
          && sealedDigestMatches(request.resource.data)
          && request.resource.data.keys().hasOnly(
               ['documentId', 'resultDigest', 'requesterId', 'assigneeId', 'createdAt']);
        allow update, delete: if false; // a request is never edited after creation

        match /response/{responseId} {
          allow read: if isTreatingProfessional(patientId);
          allow create: if responseId == 'only'
            && isTreatingProfessional(patientId)
            && request.auth.uid ==
                 get(/databases/$(database)/documents/patients/$(patientId)/reviewRequests/$(requestId)).data.assigneeId
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.keys().hasOnly(['authorId', 'note', 'createdAt']);
          // fixed id + create-only: a retry or duplicate submission fails
          // instead of overwriting the first response.
          allow update, delete: if false;
        }
      }

      // Level 6.3 tamper-evident audit trail (see docs/levels.md). Rules
      // cannot verify entryHash itself — there is no hash primitive in
      // this language — so they enforce who can write and that `seq`
      // moves forward one at a time; actual tamper-evidence is
      // lib/audit.ts's verifyChain, which recomputes every hash.
      match /auditLog/_head {
        allow read: if isTreatingProfessional(patientId);
        allow create: if isTreatingProfessional(patientId) && request.resource.data.seq == 0;
        allow update: if isTreatingProfessional(patientId)
          && request.resource.data.seq == resource.data.seq + 1;
        allow delete: if false;
      }

      match /auditLog/{entryId} {
        allow read: if isTreatingProfessional(patientId);
        allow create: if entryId != '_head'
          && isTreatingProfessional(patientId)
          && request.resource.data.actor == request.auth.uid
          && request.resource.data.keys().hasOnly(
               ['seq', 'type', 'actor', 'objectId', 'summary', 'at', 'previousHash', 'entryHash', 'recordedAt']);
        allow update, delete: if false; // append-only
      }

      // Level 6.1 documentary contradiction flagging (see docs/levels.md).
      // Manual only — no automated detection is implied or enforced here.
      match /contradictions/{contradictionId} {
        allow read: if isTreatingProfessional(patientId);
        allow create: if isTreatingProfessional(patientId)
          && request.resource.data.flaggedBy == request.auth.uid
          && request.resource.data.documentIds.size() == 2
          && request.resource.data.documentIds[0] != request.resource.data.documentIds[1]
          && exists(/databases/$(database)/documents/patients/$(patientId)/documents/$(request.resource.data.documentIds[0]))
          && exists(/databases/$(database)/documents/patients/$(patientId)/documents/$(request.resource.data.documentIds[1]))
          && request.resource.data.resolved == false
          && request.resource.data.resolvedBy == null
          && request.resource.data.resolvedAt == null
          && request.resource.data.resolutionNote == null
          && request.resource.data.flaggedAt == request.time
          && request.resource.data.keys().hasOnly(
               ['documentIds', 'note', 'flaggedBy', 'flaggedAt', 'resolved', 'resolvedBy', 'resolvedAt', 'resolutionNote']);
        // a contradiction can be resolved exactly once, and nothing else
        // about it may change — it is never re-opened or re-edited.
        allow update: if isTreatingProfessional(patientId)
          && resource.data.resolved == false
          && request.resource.data.resolved == true
          && request.resource.data.resolvedBy == request.auth.uid
          && request.resource.data.resolvedAt == request.time
          && request.resource.data.resolutionNote is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['resolved', 'resolvedBy', 'resolvedAt', 'resolutionNote']);
        allow delete: if false;
      }
    }
  }
}
